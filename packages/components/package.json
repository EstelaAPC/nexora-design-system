{
  "name": "@nexora/components",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/button.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/input/input.d.ts",
      "import": "./dist/input.js"
    },
    "./textarea": {
      "types": "./dist/textarea/textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./radio": {
      "types": "./dist/radio/radio.d.ts",
      "import": "./dist/radio.js"
    },
    "./switch": {
      "types": "./dist/switch/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./select": {
      "types": "./dist/select/select.d.ts",
      "import": "./dist/select.js"
    },
    "./icon": {
      "types": "./dist/icon/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./icon-button": {
      "types": "./dist/icon-button/icon-button.d.ts",
      "import": "./dist/icon-button.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexora/design-tokens": "*",
    "@nexora/icons": "*",
    "@nexora/theme": "*",
    "lit": "^3.1.0"
  }
}
